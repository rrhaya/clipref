#!/bin/bash
set -euo pipefail
version=0.1.0

usage() {
  cat <<'EOF'
Usage: clipref [--clipboard] [--dir DIRECTORY] [--ext EXTENSION | --name FILENAME] [--no-copy]
       clipref list [--limit COUNT]
       clipref last [--no-copy]

Save clipboard text or piped input to a local file.
Print its absolute path and copy the path to the clipboard.

  --clipboard      Read clipboard text even when stdin is not a terminal
  --dir DIRECTORY  Save in an existing directory (default: system temp directory)
  --ext EXTENSION  File extension, without a dot (default: txt)
  --name FILENAME  Save with this basename instead of input.txt
  --no-copy        Print the path without changing the clipboard
  list             List recent paths (default: 10; shell-quoted)
  last             Print and copy the most recently saved path
  --limit COUNT    List at most COUNT paths (1-1000)
  --version        Show version
  -h, --help       Show help
EOF
}

die() { printf 'clipref: %s\n' "$*" >&2; exit 1; }

save_dir=${TMPDIR:-/tmp}
extension=txt
extension_explicit=false
filename=
name_explicit=false
dir_explicit=false
copy_path=true
clipboard_input=false
mode=save
limit=10
if [ "$#" -gt 0 ]; then
  case "$1" in list|last) mode=$1; shift ;; esac
fi
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dir|--ext|--name)
      [ "$mode" = save ] || die 'save options cannot be used with history commands'
      [ "$#" -ge 2 ] || die "missing value for $1"
      case "$1" in
        --dir) save_dir=$2; dir_explicit=true ;;
        --ext) extension=$2; extension_explicit=true ;;
        --name) filename=$2; name_explicit=true ;;
      esac
      shift 2
      ;;
    --clipboard)
      [ "$mode" = save ] || die '--clipboard is only valid when saving'
      clipboard_input=true; shift ;;
    --no-copy)
      [ "$mode" != list ] || die '--no-copy cannot be used with list'
      copy_path=false; shift ;;
    --limit)
      [ "$mode" = list ] || die '--limit is only valid with list'
      [ "$#" -ge 2 ] || die 'missing value for --limit'
      if ! [[ "$2" =~ ^[1-9][0-9]{0,3}$ ]] || [ "$2" -gt 1000 ]; then
        die '--limit must be 1-1000'
      fi
      limit=$2; shift 2 ;;
    --version) printf 'clipref %s\n' "$version"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[ "$(uname -s)" = Darwin ] || die 'macOS is required'
umask 077
history_dir="${XDG_STATE_HOME:-$HOME/.local/state}/clipref/history"
history_ready() {
  [ ! -L "$history_dir" ] && [ -d "$history_dir" ] && [ -O "$history_dir" ] \
    && [ -r "$history_dir" ] && [ -w "$history_dir" ] \
    && [ "$(stat -f %Lp "$history_dir")" = 700 ]
}
copy_saved_path() {
  printf '%s\n' "$file_path"
  if [ "$copy_path" = true ]; then
    printf '%s' "$file_path" | pbcopy || die 'file saved, but copying its path failed; use the path printed above'
  fi
}
if [ "$mode" != save ]; then
  if [ ! -e "$history_dir" ] && [ ! -L "$history_dir" ]; then
    [ "$mode" = list ] && exit 0
    die 'history is empty'
  fi
  history_ready || die 'history directory must be private, owned by you, and accessible'
  shopt -s nullglob
  records=("$history_dir"/entry.*)
  if [ "${#records[@]}" -eq 0 ]; then
    [ "$mode" = list ] && exit 0
    die 'history is empty'
  fi
  count=0
  while IFS= read -r record; do
    if [ ! -f "$record" ] || [ -L "$record" ]; then continue; fi
    file_path=
    IFS= read -r -d '' file_path < "$record" || continue
    case "$file_path" in /*) ;; *) continue ;; esac
    if [ "$mode" = last ]; then
      [ -f "$file_path" ] || die 'most recent saved file no longer exists'
      copy_saved_path
      exit 0
    fi
    if [ -f "$file_path" ]; then status=exists; else status=missing; fi
    printf '%s\t%q\n' "$status" "$file_path"
    count=$((count + 1))
    [ "$count" -lt "$limit" ] || break
  done < <(ls -t -- "${records[@]}")
  [ "$mode" = list ] && exit 0
  die 'history has no valid entries'
fi
# Configuration is literal key=value data, never shell code.
config_path="${XDG_CONFIG_HOME:-$HOME/.config}/clipref/config"
trim() {
  local text=$1
  text="${text#"${text%%[![:space:]]*}"}"
  text="${text%"${text##*[![:space:]]}"}"
  printf '%s' "$text"
}
if [ -e "$config_path" ]; then
  if [ ! -f "$config_path" ] || [ ! -r "$config_path" ]; then
    die 'configuration is not a readable file'
  fi
  config_dir_seen=false
  config_ext_seen=false
  line_number=0
  while IFS= read -r line || [ -n "$line" ]; do
    line_number=$((line_number + 1))
    line=$(trim "$line")
    case "$line" in ''|\#*) continue ;; esac
    case "$line" in *=*) ;; *) die "invalid configuration at line $line_number: expected key=value" ;; esac
    key=$(trim "${line%%=*}")
    value=$(trim "${line#*=}")
    [ -n "$value" ] || die "empty configuration value at line $line_number"
    case "$key" in
      dir)
        [ "$config_dir_seen" = false ] || die 'duplicate configuration key: dir'
        config_dir_seen=true
        case "$value" in
          \~/*) value="$HOME/${value#\~/}" ;;
          /*) ;;
          *) die 'configuration dir must be an absolute path or start with ~/' ;;
        esac
        if [ "$dir_explicit" = false ]; then save_dir=$value; fi
        ;;
      ext)
        [ "$config_ext_seen" = false ] || die 'duplicate configuration key: ext'
        config_ext_seen=true
        case "$value" in ''|*[!a-zA-Z0-9_-]*) die 'invalid configuration extension' ;; esac
        if [ "$extension_explicit" = false ]; then extension=$value; fi
        ;;
      *) die "unknown configuration key at line $line_number" ;;
    esac
  done < "$config_path"
fi
if [ "$name_explicit" = true ]; then
  [ "$extension_explicit" = false ] || die '--name and --ext cannot be combined'
  case "$filename" in
    ''|.|..|*/*|*\\*|*$'\n'*|*$'\r'*|*$'\t'*) die '--name must be a single filename without separators or line breaks' ;;
  esac
else
  filename="input.$extension"
fi
case "$extension" in
  ''|*[!a-zA-Z0-9_-]*) die 'extension must contain only letters, numbers, underscores or hyphens' ;;
esac
save_dir=$(cd -- "$save_dir" 2>/dev/null && pwd -P) || die 'save directory does not exist or is inaccessible'
item_dir=$(mktemp -d "$save_dir/clipref.XXXXXX") || die 'could not create a save directory'
file_path="$item_dir/$filename"

# Remove only an incomplete file and the directory created by this invocation.
discard_incomplete() {
  rm -f -- "$file_path"
  rmdir -- "$item_dir"
}

if [ "$clipboard_input" = true ] || [ -t 0 ]; then
  if ! pbpaste > "$file_path"; then
    discard_incomplete
    die 'could not read clipboard text'
  fi
else
  if ! cat > "$file_path"; then
    discard_incomplete
    die 'could not save input'
  fi
fi

if [ ! -s "$file_path" ]; then
  discard_incomplete
  die 'input is empty'
fi

# Publish one independent record per save, so writers never share an index file.
record_history() {
  local record
  mkdir -p -- "$history_dir" || return 1
  history_ready || return 1
  record=$(mktemp "$history_dir/.pending.XXXXXX") || return 1
  if printf '%s\0' "$file_path" > "$record" \
      && mv -- "$record" "$history_dir/entry.${record##*.pending.}"; then
    return 0
  fi
  rm -f -- "$record"
  return 1
}
record_history || printf 'clipref: file saved, but history could not be recorded\n' >&2
copy_saved_path
